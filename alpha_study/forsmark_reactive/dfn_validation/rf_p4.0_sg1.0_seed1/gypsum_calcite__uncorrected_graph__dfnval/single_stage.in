REGION well
  COORDINATES
    -5.001533e+02 -3.412093e+01 3.500112e+00
    -5.001333e+02 -3.410093e+01 3.520112e+00
  /
END

#=========================== constraints ======================================
CONSTRAINT initial
  CONCENTRATIONS
    H+     7.d0  pH
    Na+    1.d-3  T
    CO3--  1.d-10  T
    Ca++   1.d-3  M Gypsum
    SO4--  1.5d-2  T
  /
  MINERALS
    Gypsum  0.9d0  750   m^2/kg     # Natural gypsum; SSA = 0.75 m2/g 
    Calcite 0.0d0  200 m^2/m^3     # source: Xu & Jiang
  /
 EQUILIBRATE_AT_EACH_CELL
END


CONSTRAINT well_initial
  CONCENTRATIONS
    H+     7.d0  pH
    Na+    1.d-3  T
    CO3--  1.d-10  T
    Ca++   1.d-3  M Gypsum
    SO4--  1.5d-2  T
  /
  MINERALS
    Gypsum  0.d0  750  m^2/kg
    Calcite 0.d0  0.d0  m^2/m^3
  /
  ACKNOWLEDGE_ZERO_SURFACE_AREA
END

CONSTRAINT well_fill
  CONCENTRATIONS
    H+     11.3900d0  pH
    Na+    1.000000e+00  T
    CO3--  5.000000e-01  T
    Ca++   1.d-10  T
    SO4--  1.d-10  T
  /
  MINERALS
    Gypsum  0.d0  750  m^2/kg
    Calcite 0.d0  0.d0  m^2/m^3
  /
  ACKNOWLEDGE_ZERO_SURFACE_AREA
END
CONSTRAINT w0
  CONCENTRATIONS
    H+     7.d0  pH
    Na+    1.d-3  T
    CO3--  1.d-10  T
    Ca++   1.d-3  M Gypsum
    SO4--  1.5d-2  T
  /
END

CONSTRAINT injection
  CONCENTRATIONS
    H+     11.3900d0  pH
    Na+    1.000000e+00  T
    CO3--  5.000000e-01  T
    Ca++   1.d-10  M Calcite
    SO4--  1.d-10  T
  /
END

#=========================== flow conditions ==================================
FLOW_CONDITION initial
  TYPE
    LIQUID_PRESSURE DIRICHLET
  /
  LIQUID_PRESSURE DATASET initial_pressure
END

DATASET initial_pressure
  FILENAME initial_pressure.h5
END

FLOW_CONDITION injection
  TYPE
    RATE VOLUMETRIC_RATE
  /
  RATE 5.134559e+01 m^3/y
END

FLOW_CONDITION boundaries
  TYPE
    LIQUID_PRESSURE DIRICHLET
  /
  LIQUID_PRESSURE 2.000000e+05
END


TRANSPORT_CONDITION well_initial
  TYPE dirichlet
  CONSTRAINT_LIST
    0.d0 well_initial
  /
END

TRANSPORT_CONDITION well_fill
  TYPE dirichlet
  CONSTRAINT_LIST
    0.d0 well_fill
  /
END

TRANSPORT_CONDITION initial
  TYPE dirichlet 
    CONSTRAINT_LIST
    0.d0 initial
  /
END


TRANSPORT_CONDITION seepage_face
  TYPE ZERO_GRADIENT
    CONSTRAINT_LIST
    0.d0 initial
  /
END

TRANSPORT_CONDITION inflow_conc
  TYPE ZERO_GRADIENT
  CONSTRAINT_LIST
    0.d0 injection
  /
END


# initial condition
INITIAL_CONDITION
  FLOW_CONDITION initial
  TRANSPORT_CONDITION initial
  REGION All
/

INITIAL_CONDITION
  FLOW_CONDITION initial
  TRANSPORT_CONDITION well_fill
  REGION well
/

INITIAL_CONDITION
  FLOW_CONDITION initial
  TRANSPORT_CONDITION well_initial
  REGION graph_inlet_cells
/

INITIAL_CONDITION
  FLOW_CONDITION initial
  TRANSPORT_CONDITION well_initial
  REGION graph_outlet_cells
/

INITIAL_CONDITION
  FLOW_CONDITION initial
  TRANSPORT_CONDITION well_initial
  REGION helper_cells
/

SOURCE_SINK inflow
    FLOW_CONDITION injection
    TRANSPORT_CONDITION inflow_conc
    REGION well
END

## east boundary condition
BOUNDARY_CONDITION outflow
  FLOW_CONDITION boundaries
  TRANSPORT_CONDITION seepage_face
  REGION outflow
/


#=========================== stratigraphy couplers ============================
STRATA
  REGION All 
  MATERIAL fractures
END

NUMERICAL_METHODS TRANSPORT
  TIMESTEPPER
    TS_ACCELERATION 10
  /
END

END_SUBSURFACE


